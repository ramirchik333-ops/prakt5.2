<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/kinopoisk_black">

    <!-- Заголовок -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="@color/kinopoisk_red"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <!-- Поле поиска -->
    <EditText
        android:id="@+id/etSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_search_movie"
        android:textColorHint="@color/kinopoisk_gray"
        android:textColor="@color/kinopoisk_white"
        android:background="@android:color/transparent"
        android:padding="12dp"
        android:inputType="text" />

    <!-- Кнопки: Найти и Избранное -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp">

        <Button
            android:id="@+id/btnSearch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/btn_search"
            android:backgroundTint="@color/kinopoisk_red"
            android:textColor="@color/kinopoisk_white"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnSaved"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/tab_saved"
            android:backgroundTint="@color/kinopoisk_gray"
            android:textColor="@color/kinopoisk_white"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <!-- Список фильмов -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</LinearLayout>